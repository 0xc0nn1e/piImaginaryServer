# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true
API_TOKEN=
API_BIND_HOST=127.0.0.1
API_PORT=8000

# Browser management UI. WEB_SETUP_TOKEN must be a synthetic/local secret of
# at least 32 characters and is used only for the first admin account. It is
# never injected into the web container or browser bundle. For HTTPS, use the
# exact public origin and set WEB_COOKIE_SECURE=true.
WEB_SETUP_TOKEN=
WEB_SESSION_HOURS=12
WEB_COOKIE_SECURE=false
WEB_ALLOWED_ORIGIN=http://127.0.0.1:3000
WEB_AUTH_MAX_REQUEST_BYTES=4096
WEB_LOGIN_MAX_ATTEMPTS=5
WEB_LOGIN_WINDOW_SECONDS=300
WEB_LOGIN_RATE_LIMIT_ENTRIES=2048
# Addresses/CIDR ranges whose X-Forwarded-For is trusted when identifying a
# login client. Empty trusts no proxy and uses the direct peer address. Only
# list peers that always reach the API through the proxy; see the README, since
# the directly published API port shares the Docker bridge range.
TRUSTED_PROXY_IPS=
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000
# Set false before building the web image to hide backend health polling/status.
VITE_SHOW_HEALTH=true

# PostgreSQL. DATABASE_URL is used by native/local processes. Docker Compose
# builds its internal URL from POSTGRES_* so the database hostname is correct.
DATABASE_URL=postgresql+psycopg://audio_server:replace-me@127.0.0.1:5432/audio_server
POSTGRES_DB=audio_server
POSTGRES_USER=audio_server
POSTGRES_PASSWORD=
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# Persistent storage and upload validation
STORAGE_PATH=./data
MAX_UPLOAD_BYTES=536870912
MAX_METADATA_BYTES=16384
MAX_AUDIO_DURATION_SECONDS=21600
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT_SECONDS=3600

# Durable PostgreSQL job queue
PROCESSING_WORKERS=1
PROCESSING_MAX_ATTEMPTS=3
JOB_POLL_SECONDS=1
JOB_HEARTBEAT_SECONDS=30
JOB_LEASE_SECONDS=300
JOB_RECOVERY_SECONDS=30
RETRY_BASE_SECONDS=30
RETRY_MAX_SECONDS=900

# Speech-to-text. Leave WHISPER_LANGUAGE blank for automatic detection.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=4
WHISPER_CACHE_DIR=./data/model-cache/huggingface

# Speaker diarization. The Community-1 model is gated and requires an accepted
# Hugging Face agreement plus a read token when enabled.
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
HUGGINGFACE_TOKEN=
PYANNOTE_METRICS_ENABLED=0
HF_HOME=./data/model-cache/huggingface
TORCH_HOME=./data/model-cache/torch

# LM Studio analysis is optional and disabled by default. Only the worker gets
# these values. Use the remote machine's trusted-LAN host:port.
LLM_ENABLED=false
LLM_PROVIDER=disabled
LM_STUDIO_HOST=127.0.0.1:1234
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_SECONDS=600
LM_STUDIO_CHUNK_CHARS=12000
LM_STUDIO_MAX_TOKENS=4096

# Docker CPU worker dependency pair. Change together only after checking the
# official TorchCodec/PyTorch compatibility table.
PYTORCH_VERSION=2.11.0
TORCHCODEC_VERSION=0.13.0

# Reserved for a future safe retention worker. Blank disables each policy; a
# configured value must be a positive number of days. The MVP deletes nothing.
AUDIO_RETENTION_DAYS=
TRANSCRIPT_RETENTION_DAYS=
